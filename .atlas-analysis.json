  "keyFeatures": [
    "Dual-character XP tracking for Wallas and Melynna",
    "Level progression system (1 level per 1,000 XP)",
    "Rule-based XP rewards and penalties",
    "3D GLB/GLTF avatar viewer with animation mapping",
    "Mission history with image attachments",
    "AI-generated .wgo update package import",
    "Offline-first with Room + DataStore persistence",
    "Backup and restore before applying updates",
    "Motivational villains: Preguix, Desanimax, Distrax",
    "Android native (Kotlin + Jetpack Compose + SceneView/Filament)"
  ],
